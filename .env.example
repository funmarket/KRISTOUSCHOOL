# Public browser configuration. The URL and publishable/anon key identify a Supabase
# project; neither value authorizes access by itself. Access is controlled by
# database grants, Row Level Security, and server-side authorization.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-side secrets belong only in a protected local/deployment secret store.
# Never prefix these with VITE_ or expose them to the browser.
SUPABASE_SECRET_KEY=""
DATABASE_URL=""
